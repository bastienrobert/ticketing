{
  "private": true,
  "name": "@ticketing/server",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "predeploy": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "drizzle-kit": "^0.31.11",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
