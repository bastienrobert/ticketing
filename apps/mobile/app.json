{
  "expo": {
    "name": "Ticketing",
    "slug": "ticketing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ticketing",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bastienrobert.ticketing",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": false,
        "CFBundleLocalizations": [
          "fr"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "locales": {
      "fr": "./src/data/messages/native/fr.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "fr"
          ],
          "supportsRTL": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f7"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": false,
      "eas": {
        "projectId": "687595dc-f95c-449f-af0a-1295700fce02"
      }
    },
    "owner": "bastienrobert"
  }
}
